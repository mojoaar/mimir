# Copy to .env and fill in. Required values have no defaults.
# Generate the secret with: openssl rand -hex 32
# Store it OUTSIDE this file — it also keys every encrypted backup.
MIMIR_SECRET=
MIMIR_PUBLIC_URL=http://localhost:3000
MIMIR_ADMIN_EMAIL=
MIMIR_ADMIN_PASSWORD=
# Comma-separated IPs/CIDRs of your reverse proxy. Leave empty when there is none.
MIMIR_TRUSTED_PROXIES=

# docker compose: both passwords must be URL-safe (letters, digits, - and _),
# because they are interpolated into the connection URIs below.
POSTGRES_OWNER_PASSWORD=
MIMIR_APP_PASSWORD=

# Development without compose (scripts/test-db.sh up listens on 5433):
DATABASE_URL=postgres://mimir_app:app_dev_password@127.0.0.1:5433/mimir
DATABASE_ADMIN_URL=postgres://mimir_owner:owner_dev_password@127.0.0.1:5433/mimir
